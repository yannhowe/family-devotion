# Local SQLite. This is the default when DATABASE_URL is unset and you are not on Vercel.
DATABASE_URL=file:./data/devotion.db

# Turso / libSQL, used on Vercel. The Marketplace integration sets these two names.
# If both DATABASE_URL and TURSO_DATABASE_URL are set, DATABASE_URL wins.
# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=

# Optional. When set, /admin can add a prayer or a verse. When unset, the site is read-only.
# ADMIN_PASSWORD=

# Optional. Token from https://api.esv.org/ (the key only, not the word Token).
# When set, passages are shown from the English Standard Version. When unset, the site uses the World English Bible.
# The free ESV API is for non-commercial personal, church, and ministry use.
# ESV_API_KEY=

# Optional. Unused for now. Reserved for a later Vestaboard.
# VESTABOARD_READ_WRITE_KEY=
